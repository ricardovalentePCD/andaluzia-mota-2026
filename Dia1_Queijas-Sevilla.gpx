      <name>Rosal de la Frontera</name>
      <desc>Fronteira PT/ES</desc>
    </rtept>
    <rtept lat="37.8906" lon="-6.5487">
      <name>Aracena - Sierra Morena</name>
      <desc>N-433: estradas abertas na Serra de Aracena</desc>
    </rtept>
    <rtept lat="37.8347" lon="-6.3148">
      <name>Zufre - Sierra Norte</name>
      <desc>Parque Natural Sierra Norte de Sevilla</desc>
    </rtept>
    <rtept lat="37.3891" lon="-5.9845">
      <name>Sevilla - Chegada</name>
