    <desc>Dia 1 | 1 Out | Queijas → Sierra Morena → Sevilha (~330 km)</desc>
  </metadata>
  <rte>
    <name>Dia1_Queijas-Sevilla</name>
    <desc>Dia 1 | 1 Out | Queijas → Sierra Morena → Sevilha (~330 km)</desc>
    <rtept lat="38.7123" lon="-9.2553">
      <name>Queijas - Partida</name>
