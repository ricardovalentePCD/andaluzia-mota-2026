    </rtept>
    <rtept lat="38.3717" lon="-8.5125">
      <name>Alcacer do Sal</name>
      <desc>Castelo e rio Sado. Paragem rápida</desc>
    </rtept>
    <rtept lat="38.0151" lon="-7.8639">
      <name>Beja</name>
      <desc>Almoço recomendado. Centro histórico romano</desc>
    </rtept>
    <rtept lat="37.9444" lon="-7.5988">
      <name>Serpa</name>
      <desc>Vila murada belíssima. Paragem obrigatória</desc>
    </rtept>
